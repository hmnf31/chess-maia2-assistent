{
    "manifest_version": 3,
    "name": "My Chess Assistant (Maia-2 Edition)",
    "version": "3.0",
    "permissions": ["storage"],
    "host_permissions": [
      "http://127.0.0.1:5000/*",
      "*://*.chess.com/*",
      "*://*.lichess.org/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Maia-2 Settings"
    },
    "content_scripts": [
      {
        "matches": ["*://*.chess.com/*", "*://*.lichess.org/*"],
        "js": ["content.js"]
      }
    ]
  }

  