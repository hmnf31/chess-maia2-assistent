{
    "manifest_version": 3,
    "name": "Maia-2 Human-like Chess Engine",
    "version": "4.0",
    "permissions": ["storage"],
    "host_permissions": [
      "http://127.0.0.1:5000/*",
      "https://*.hf.space/*",
      "https://*.huggingface.co/*",
      "*://*.chess.com/*",
      "*://*.lichess.org/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Maia-2 Human Config"
    },
    "content_scripts": [
      {
        "matches": ["*://*.chess.com/*", "*://*.lichess.org/*"],
        "js": ["content.js"]
      }
    ]
  }

  